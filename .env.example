# Copia este archivo como .env.local para desarrollo, o define estas mismas
# variables en el stack de Portainer para producción.
#
# IMPORTANTE: al empezar por NEXT_PUBLIC_, Next.js las incrusta en el
# JavaScript del cliente durante el "build". Deben estar definidas ANTES de
# construir la imagen (se pasan como build-args en el Dockerfile/compose),
# no basta con definirlas solo en el contenedor en tiempo de ejecución.

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica
